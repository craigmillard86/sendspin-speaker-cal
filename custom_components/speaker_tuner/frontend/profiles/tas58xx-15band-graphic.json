  "yaml_template": "# Speaker Tuner {{tool_version}}: {{profile_name}}\n# Device: {{device_name}}, exported {{date}}\n#\n# The tas58xx 15-band EQ saves the gains you set from Home Assistant on the device, so\n# they survive reboots and reflashing. The component has no YAML setting for them, so\n# these substitutions are a record of the tuning: keep them with your device YAML, and\n# use Speaker Tuner's \"Copy to another device\" to set a second speaker the same way.\n\nsubstitutions:\n  left_eq_gain_20hz: \"{{left_eq_1_gain}}\"\n  left_eq_gain_31_5hz: \"{{left_eq_2_gain}}\"\n  left_eq_gain_50hz: \"{{left_eq_3_gain}}\"\n  left_eq_gain_80hz: \"{{left_eq_4_gain}}\"\n  left_eq_gain_125hz: \"{{left_eq_5_gain}}\"\n  left_eq_gain_200hz: \"{{left_eq_6_gain}}\"\n  left_eq_gain_315hz: \"{{left_eq_7_gain}}\"\n  left_eq_gain_500hz: \"{{left_eq_8_gain}}\"\n  left_eq_gain_800hz: \"{{left_eq_9_gain}}\"\n  left_eq_gain_1250hz: \"{{left_eq_10_gain}}\"\n  left_eq_gain_2000hz: \"{{left_eq_11_gain}}\"\n  left_eq_gain_3150hz: \"{{left_eq_12_gain}}\"\n  left_eq_gain_5000hz: \"{{left_eq_13_gain}}\"\n  left_eq_gain_8000hz: \"{{left_eq_14_gain}}\"\n  left_eq_gain_16000hz: \"{{left_eq_15_gain}}\"\n  right_eq_gain_20hz: \"{{right_eq_1_gain}}\"\n  right_eq_gain_31_5hz: \"{{right_eq_2_gain}}\"\n  right_eq_gain_50hz: \"{{right_eq_3_gain}}\"\n  right_eq_gain_80hz: \"{{right_eq_4_gain}}\"\n  right_eq_gain_125hz: \"{{right_eq_5_gain}}\"\n  right_eq_gain_200hz: \"{{right_eq_6_gain}}\"\n  right_eq_gain_315hz: \"{{right_eq_7_gain}}\"\n  right_eq_gain_500hz: \"{{right_eq_8_gain}}\"\n  right_eq_gain_800hz: \"{{right_eq_9_gain}}\"\n  right_eq_gain_1250hz: \"{{right_eq_10_gain}}\"\n  right_eq_gain_2000hz: \"{{right_eq_11_gain}}\"\n  right_eq_gain_3150hz: \"{{right_eq_12_gain}}\"\n  right_eq_gain_5000hz: \"{{right_eq_13_gain}}\"\n  right_eq_gain_8000hz: \"{{right_eq_14_gain}}\"\n  right_eq_gain_16000hz: \"{{right_eq_15_gain}}\"\n"
