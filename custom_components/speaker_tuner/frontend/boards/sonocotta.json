{
  "maker": "Sonocotta",
  "source": "https://github.com/sonocotta/esp32-audio-dock",
  "notes": "Board metadata for detection only, not speaker profiles. 'project' matches the model Home Assistant shows for Sonocotta's factory firmware (ESPHome project 'sonocotta.<model>'); per-board configs without project: are recognised by their DAC component's entities instead.",
  "families": [
    {
      "id": "louder",
